---
import { Image } from "astro:assets";
import SubtitleSection from "@astro/SubtitleSection.astro";
---

<SubtitleSection title="Sobre mi" />

<section
  class="flex flex-col items-center justify-center gap-8 p-2 sm:h-72 sm:flex-row"
>
  <div
    class="flex max-w-[28rem] flex-col gap-2 text-pretty text-base font-varela"
  >
    <p>
      Me llamo <strong>Henrik Lagos</strong> y tengo <strong>21 años</strong>.
      Soy <strong>Programador junior</strong>.
    </p>
    <p>
      Estudié <strong>Ingeniería en informatica</strong> en la <strong
        >Universidad Federico Santa Maria</strong
      >. 🎓
    </p>
    <p>
      Actualmente, me desempeño como <strong>desarrollador junior</strong>.
    </p>
  </div>
  <Image
    width={300}
    height={300}
    src="/leofino.webp"
    alt="Henrik Lagos"
    loading={"lazy"}
    class="size-64 rounded-2xl object-cover shadow-2xl rotate-3 hover:rotate-0 transition duration-300"
  />
</section>
